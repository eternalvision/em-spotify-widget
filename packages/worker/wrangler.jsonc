{
  "name": "spotify-widget",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../widget/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/embed", "/card.svg"],
  },
  "kv_namespaces": [{ "binding": "TOKENS", "id": "7f1b1c599e2d40ae912b7f72aa3158a8" }],
  "routes": [{ "pattern": "spotify-widget.eternalvision.cc", "custom_domain": true }],
  "vars": { "MOCK": "false" },
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
